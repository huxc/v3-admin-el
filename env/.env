# title
VITE_GLOB_APP_TITLE = ca-admin-template

# 公共基础路径
VITE_PUBLIC_PATH = /

# 打包输入的文件夹
VITE_OUTPUT_DIR = dist

# 本地运行端口号
VITE_PORT = 8808

# 启动时自动打开浏览器
VITE_OPEN = true

# 打包后是否生成包分析文件
VITE_REPORT = false

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 打包压缩后是否删除源文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = true

# 是否启用 gzip 或 brotli 压缩打包，如果需要多个压缩规则，可以使用 “,” 分隔
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = gzip

# 是否启用微服务域名
VITE_IS_MICRO_SERVICE = true

# 请求接口是否显示loading (全局)
VITE_IS_LOADING = true

# token 过期状态码
VITE_ACCESS_TOKEN_EXP = 401

# token 过期状态码
VITE_IS_REFRESH_TOKEN = true
